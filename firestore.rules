rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isCoupleMember(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    // Abo-Felder. Geschrieben werden sie ausschließlich vom Backend über das
    // Admin SDK (RevenueCat-Webhook + syncEntitlement-Callable), das die Rules
    // umgeht. Für jeden Client sind sie unveränderlich — sonst wäre die Paywall
    // ein Vorschlag und kein Gate.
    function entitlementFields() {
      return ['plan', 'premiumUntil', 'premiumStore', 'premiumUpdatedAt', 'rcAppUserId'];
    }

    function entitlementUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(entitlementFields());
    }

    match /users/{userId} {
      allow create, read, update, delete: if isSelf(userId);
    }

    match /couples/{coupleId} {
      // Read is open to authenticated users because the current join flow
      // looks up a couple by inviteCode before the user becomes a member.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.inviteCode is string
        // Kein Paar startet als Premium.
        && !request.resource.data.keys().hasAny(entitlementFields());

      allow update: if signedIn()
        && entitlementUntouched()
        && (
          // Normaler Fall: der Aufrufer bleibt Mitglied (Budget/Kategorien/
          // Avatar/Einladungscode/Beitritt des Partners ändern, etc.).
          (request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() <= 2
            && request.auth.uid in request.resource.data.memberIds)
          ||
          // Austritt: der Aufrufer entfernt NUR sich selbst aus memberIds
          // (Konto löschen) — war vorher Mitglied, ist es danach nicht mehr,
          // alle verbleibenden Einträge gab es vorher schon.
          (request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(request.resource.data.memberIds))
        );
    }

    // KI-Verbrauchszähler pro Paar. Nur das Backend schreibt (Transaktion in
    // functions/src/lib/rateLimit.ts) — sonst könnte der Client seine Quote
    // einfach zurücksetzen.
    match /usage/{coupleId} {
      allow read: if isCoupleMember(coupleId);
      allow write: if false;
    }

    // Idempotenz-Log des RevenueCat-Webhooks. Für Clients komplett dicht.
    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }

    match /chores/{choreId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    // Persönliche Schnell-Aufgaben fürs Dashboard: Verknüpfungen auf bestehende
    // Chores (welcher Chore ist wessen Favorit).
    match /favoriteChores/{favId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /choreHistory/{entryId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /shoppingItems/{itemId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.addedBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /shoppingLists/{listId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /recipes/{recipeId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /mealPlans/{planId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /expenses/{expenseId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /financeEvents/{eventId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /resources/{resourceId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /bookings/{bookingId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /bucketListItems/{itemId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /trips/{tripId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    match /notes/{noteId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow update, delete: if isCoupleMember(resource.data.coupleId);
    }

    // Wochenberichte des Paar-Coachs. Beide Partner sehen denselben Bericht —
    // wer ihn auslöst, erzeugt ihn für beide. Kein update: ein Bericht ist eine
    // Momentaufnahme seiner Woche und wird nicht nachträglich verändert.
    match /coachReports/{reportId} {
      allow read: if isCoupleMember(resource.data.coupleId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isCoupleMember(request.resource.data.coupleId);
      allow delete: if isCoupleMember(resource.data.coupleId);
    }
  }
}
