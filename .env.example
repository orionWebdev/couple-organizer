# Kopiere diese Datei nach .env.local (gitignored) und trage die echten Werte ein.
#
# Der Gemini-Key steht hier NICHT mehr: er liegt serverseitig im Secret Manager,
# weil er im Client-Bundle aus jeder APK extrahierbar wäre. Setzen mit:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set REVENUECAT_SECRET_KEY
#   firebase functions:secrets:set REVENUECAT_WEBHOOK_SECRET

# App Check (Web): reCAPTCHA-Enterprise-Site-Key aus der Firebase Console
# -> Build -> App Check -> Apps -> Web. Ohne ihn lehnen die KI-Callables ab.
# Im Dev-Build loggt der Browser zusätzlich ein Debug-Token in die Konsole, das
# einmalig unter App Check -> Apps -> "Debug-Tokens verwalten" eingetragen wird.
VITE_APPCHECK_SITE_KEY=

# RevenueCat Public SDK Key (Android) — RevenueCat Dashboard -> API Keys.
# Nur der native Build braucht ihn; im Web bleibt die Paywall ein Hinweis.
VITE_RC_ANDROID_KEY=
